# The Buildkite environment reaches templates through .Env.

env BUILDKITE_BRANCH=release/v2
env BUILDKITE_PULL_REQUEST=false
env MY_CUSTOM=hello

exec pipefitter generate
stdout 'branch: release/v2'
stdout 'custom: hello'
# Note the quoting: goccy quotes "no" because YAML 1.1 reads it as a boolean.
# That is the serializer protecting the value, and worth knowing when writing
# templates that emit yes/no/on/off.
stdout 'pr: "no"' 

# BUILDKITE_PULL_REQUEST=false is the literal string "false", which is truthy in
# a template. IsPR must not be fooled by it.
env BUILDKITE_PULL_REQUEST=123
exec pipefitter generate
stdout 'pr: "yes"' 

-- .buildkite/pipefitter/test.tmpl --
steps:
  - key: test
    branch: "{{ .Env.Buildkite.Branch }}"
    custom: "{{ .Env.Vars.MY_CUSTOM }}"
    pr: "{{ if .Env.Buildkite.PullRequest.IsPR }}yes{{ else }}no{{ end }}"
